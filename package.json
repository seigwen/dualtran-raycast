{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dualtran",
  "title": "DualTran",
  "description": "Translate selected text or the clipboard with Google or your own AI model (BYOK, 20+ providers).",
  "icon": "icon.png",
  "author": "seigwen",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "translate-selected-text",
      "title": "Translate Selected Text",
      "description": "Translate the selected text and show it next to the original.",
      "mode": "view"
    },
    {
      "name": "translate-clipboard",
      "title": "Translate Clipboard",
      "description": "Translate the clipboard contents.",
      "mode": "view"
    },
    {
      "name": "choose-ai-provider",
      "title": "Choose AI Provider",
      "description": "Pick from the built-in providers and everything models.dev lists.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "engine",
      "title": "Engine",
      "description": "Google is free and needs no key. AI uses your own provider key (BYOK).",
      "type": "dropdown",
      "required": false,
      "default": "google",
      "data": [
        {
          "title": "Google",
          "value": "google"
        },
        {
          "title": "AI (BYOK)",
          "value": "ai"
        }
      ]
    },
    {
      "name": "sourceLanguage",
      "title": "Source Language",
      "description": "\"auto\" detects the language.",
      "type": "textfield",
      "required": false,
      "default": "auto"
    },
    {
      "name": "targetLanguage",
      "title": "Target Language",
      "description": "Language code to translate into (en, zh-CN, ja, …).",
      "type": "textfield",
      "required": false,
      "default": "en"
    },
    {
      "name": "aiProvider",
      "title": "AI Provider",
      "description": "Built-in providers. Run “Choose AI Provider” for the 200+ providers from models.dev (the pick is remembered).",
      "type": "dropdown",
      "required": false,
      "default": "openai",
      "data": [
        {
          "title": "OpenAI",
          "value": "openai"
        },
        {
          "title": "Google Gemini",
          "value": "google-gemini"
        },
        {
          "title": "DeepSeek",
          "value": "deepseek"
        },
        {
          "title": "Moonshot",
          "value": "moonshot"
        },
        {
          "title": "Zhipu",
          "value": "zhipu"
        },
        {
          "title": "Groq",
          "value": "groq"
        },
        {
          "title": "Mistral",
          "value": "mistral"
        },
        {
          "title": "xAI",
          "value": "xai"
        },
        {
          "title": "OpenRouter",
          "value": "openrouter"
        },
        {
          "title": "SiliconFlow",
          "value": "siliconflow"
        },
        {
          "title": "Ollama (local)",
          "value": "ollama"
        }
      ]
    },
    {
      "name": "aiReasoning",
      "title": "AI Reasoning Effort",
      "description": "“Lowest” uses the smallest level the selected model accepts; unsupported levels are dropped.",
      "type": "dropdown",
      "required": false,
      "default": "lowest",
      "data": [
        {
          "title": "Lowest (default)",
          "value": "lowest"
        },
        {
          "title": "Provider default",
          "value": "default"
        },
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Minimal",
          "value": "minimal"
        },
        {
          "title": "Low",
          "value": "low"
        },
        {
          "title": "Medium",
          "value": "medium"
        },
        {
          "title": "High",
          "value": "high"
        },
        {
          "title": "XHigh",
          "value": "xhigh"
        },
        {
          "title": "Max",
          "value": "max"
        }
      ]
    },
    {
      "name": "aiApiKey",
      "title": "AI API Key",
      "description": "Stored locally by Raycast only.",
      "type": "password",
      "required": false
    },
    {
      "name": "aiModel",
      "title": "AI Model",
      "description": "Model id passed to the provider (e.g. gpt-4o-mini).",
      "type": "textfield",
      "required": false
    },
    {
      "name": "aiBaseUrl",
      "title": "AI Base URL (optional)",
      "description": "Override the provider endpoint.",
      "type": "textfield",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.8.0",
    "dualtran": "file:vendor/dualtran-core.tgz"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "@ai-sdk/anthropic": "^3.0.82",
    "@ai-sdk/azure": "^3.0.71",
    "@ai-sdk/cohere": "^3.0.38",
    "@ai-sdk/deepinfra": "^2.0.54",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/perplexity": "^3.0.35",
    "@ai-sdk/togetherai": "^2.0.55",
    "@ai-sdk/xai": "^3.0.93",
    "ai": "^6.0.199",
    "common-tags": "^1.8.2",
    "eslint": "^9.39.0",
    "eventsource-parser": "^1.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "ray publish",
    "test": "jest && node scripts/smoke-core.mjs",
    "i18n:build": "node scripts/build-i18n.mjs",
    "i18n:sync": "node scripts/locale-kit.mjs",
    "i18n:check": "node scripts/locale-kit.mjs --check",
    "verify": "npm test && npm run i18n:check && npm run test:dist",
    "test:dist": "node scripts/smoke-dist.mjs"
  }
}
